# Copiez ce fichier en .env (même dossier) puis adaptez les valeurs.
# Le fichier .env n'est jamais publié en ligne.

# ---------------------------------------------------------------------------
# Hygraph — adresse de l'API de contenu
# Hygraph → Project settings → API Access → Content API → copier l'URL
# Laisser vide fait afficher les contenus de démonstration.
# ---------------------------------------------------------------------------
HYGRAPH_ENDPOINT="https://ap-south-1.cdn.hygraph.com/content/VOTRE_PROJET/master"

# ---------------------------------------------------------------------------
# Noms des modèles Hygraph (facultatif)
# Déjà utilisés par défaut : actualites, evenements, annonces, galeries, videos
# ---------------------------------------------------------------------------
# HYGRAPH_NEWS_MODEL=actualites
# HYGRAPH_EVENT_MODEL=evenements
# HYGRAPH_ANNOUNCEMENT_MODEL=annonces
# HYGRAPH_GALLERY_MODEL=galeries
# HYGRAPH_VIDEO_MODEL=videos

# ---------------------------------------------------------------------------
# Google Maps — clé « navigateur » de la connexion Google Maps du projet
# Sert uniquement à afficher la carte de la page Contact.
# En local, recopier les valeurs écrites dans le .env du projet hébergé.
# Sans ces valeurs, la page Contact affiche un simple lien vers Google Maps.
# ---------------------------------------------------------------------------
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=""
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=""
